<!-- Side Menu Script -->
<script type="text/javascript">
$(document).ready(function () {
	$('#dismiss, .overlay').on('click', function () {
		$('#sidebar').addClass('active');
		$('.overlay').removeClass('active');
	});

	$('#sidebarCollapse').on('click', function () {
		$('#sidebar, #content').toggleClass('active');
		$('.overlay').addClass('active');
		$('.collapse.in').toggleClass('in');
		$('a[aria-expanded=true]').attr('aria-expanded', 'false');
	});
});
</script>
	
<!-- Show & Hide Password Script -->
<script type="application/javascript">
	// Frist Eye Script //
	document.addEventListener('DOMContentLoaded', function () {
    	const toggleButton = document.querySelector('#show_hide_password button');
		const passwordInput = document.querySelector('#passwordInput');
    	const toggleIcon = document.querySelector('#showHidePassword');

    	toggleButton.addEventListener('click', function (event) {
        	event.preventDefault();
			
        	// Toggle the type attribute
        	const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        	passwordInput.setAttribute('type', type);
			
        	// Toggle the eye icon class
        	if (type === 'text') {
            	toggleIcon.classList.remove('fa-eye');
            	toggleIcon.classList.add('fa-eye-slash');
        	} else {
            	toggleIcon.classList.remove('fa-eye-slash');
            	toggleIcon.classList.add('fa-eye');
        	}
    	});
	});
	
	// Second Eye Script //
	document.addEventListener('DOMContentLoaded', function () {
    	const toggleButton = document.querySelector('#show_hide_password-2 button');
		const passwordInput = document.querySelector('#passwordInput-2');
    	const toggleIcon = document.querySelector('#showHidePassword-2');

    	toggleButton.addEventListener('click', function (event) {
        	event.preventDefault();
			
        	// Toggle the type attribute
        	const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        	passwordInput.setAttribute('type', type);
			
        	// Toggle the eye icon class
        	if (type === 'text') {
            	toggleIcon.classList.remove('fa-eye');
            	toggleIcon.classList.add('fa-eye-slash');
        	} else {
            	toggleIcon.classList.remove('fa-eye-slash');
            	toggleIcon.classList.add('fa-eye');
        	}
    	});
	});
	
	// Third Eye Script //
	document.addEventListener('DOMContentLoaded', function () {
    	const toggleButton = document.querySelector('#show_hide_password-3 button');
		const passwordInput = document.querySelector('#passwordInput-3');
    	const toggleIcon = document.querySelector('#showHidePassword-3');

    	toggleButton.addEventListener('click', function (event) {
        	event.preventDefault();
			
        	// Toggle the type attribute
        	const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
        	passwordInput.setAttribute('type', type);
			
        	// Toggle the eye icon class
        	if (type === 'text') {
            	toggleIcon.classList.remove('fa-eye');
            	toggleIcon.classList.add('fa-eye-slash');
        	} else {
            	toggleIcon.classList.remove('fa-eye-slash');
            	toggleIcon.classList.add('fa-eye');
        	}
    	});
	});
</script>
	
